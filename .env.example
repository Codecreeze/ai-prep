# Copy this file to .env.local and fill in real values. .env.local is gitignored —
# never commit real keys.

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-prep
SESSION_SECRET=replace-with-a-long-random-string

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_REQUESTS_PER_MINUTE=10

# Optional: enables public-discussion search. Without it, that step gracefully
# returns "nothing found" instead of failing.
TAVILY_API_KEY=

NODE_ENV=development
# Required for the batch `evaluate` command / local dev, since company sites under
# test may be served from localhost. Must be unset/false in production.
ALLOW_LOCAL_URLS=true
